# Copy to .env — loaded by `npm start` / `npm run dev:server` (Node --env-file-if-exists).
PORT=8787
DB_PATH=data/terrastra.db
# NODE_ENV=production
# BASE_URL=https://terrastra.example  # required when NODE_ENV=production
# DEV_LOGIN=1            # testing only: returns magic links in the API response
# INSECURE_COOKIES=1     # plain-HTTP staging only

# Sign-in mail (full edition). MAIL_FROM plus one transport; HTTP API wins if both are set.
# MAIL_FROM=Terrastra <hello@example.com>
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# INSECURE_MAIL_API=1    # production HTTP relay on an isolated network only
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_CA_FILE=
