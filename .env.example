# Copy to .env (read by the Next app, the Prisma CLI and `npm run db:setup`). Everything is optional for local use.

# Database. Unset: a local SQLite file, .data/terrastra.db (development). Production: Postgres, e.g.
# DATABASE_URL=postgresql://terrastra:terrastra@localhost:5433/terrastra   # `docker compose up db`
# After switching between SQLite and Postgres, run `npm run db:setup` (it regenerates the Prisma client).

# Auth (NextAuth). NEXTAUTH_SECRET is required in production: `openssl rand -base64 32`.
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# DEV_LOGIN=1            # testing only: magic links are kept for /api/dev/mailbox instead of being mailed
# INSECURE_COOKIES=1     # plain-HTTP staging only (production cookies are Secure)

# Sign-in by email: MAIL_FROM plus one transport; the HTTP API wins if both are set.
# MAIL_FROM=Terrastra <hello@example.com>
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_CA_FILE=

# Sign-in with GitHub / Google (optional).
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_ID=
# GOOGLE_SECRET=

# Static (GitHub Pages) build: where "the full edition" link points.
# VITE_FULL_URL=https://app.terrastra.example
